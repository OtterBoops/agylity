{
  "name": "agylity",
  "version": "0.4.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Autonomous Quota Sentry & Remote Task Coordinator for Google Antigravity",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build:client": "npm --prefix frontend run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "dev:client": "npm --prefix frontend run dev",
    "dev:server": "tsx watch --no-warnings --env-file-if-exists=.env src/index.ts",
    "dev": "npm run build:client && tsx watch --no-warnings --env-file-if-exists=.env src/index.ts",
    "dev:runner": "tsx --no-warnings --env-file-if-exists=.env src/runner-cli.ts",
    "start": "node --no-warnings --env-file-if-exists=.env dist/index.js",
    "start:runner": "node --no-warnings --env-file-if-exists=.env dist/runner-cli.js",
    "lint": "prettier --check . && eslint frontend/src",
    "format": "eslint --fix frontend/src && prettier --write .",
    "test": "node --no-warnings --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && npm --prefix frontend run typecheck"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "ky": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
