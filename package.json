{
  "name": "agylity",
  "version": "0.2.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Autonomous Quota Sentry & Remote Task Orchestrator for Google Antigravity",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:client": "npm --prefix frontend run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "dev:client": "npm --prefix frontend run dev",
    "dev:server": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev": "npm run build:client && tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --no-warnings --env-file-if-exists=.env dist/index.js",
    "lint": "prettier --check . && node scripts/check-canonical-classes.mjs",
    "format": "prettier --write .",
    "test": "node --no-warnings --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "ky": "^2.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
