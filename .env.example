# ==============================================================================
# agylity - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your deployment.
# Values defined here serve as Level 2 fallback precedence:
# Resolved Config = SQLite UI Overrides ?? Environment Variables (.env) ?? Built-in Defaults
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Channel Notifications
# ------------------------------------------------------------------------------
# Active notification channels (comma-separated): discord, webhook, console, none
# Multiple channels can be active simultaneously (e.g. NOTIFICATION_CHANNELS=discord,webhook)
# Dynamic import isolation ensures only active adapters load into memory.
# Default: none (silent sentry mode)
NOTIFICATION_CHANNELS=none

# Discord Bot Configuration (Used if discord is in NOTIFICATION_CHANNELS)
# Bot token generated in the Discord Developer Portal (Bot -> Reset Token)
# Automatically encrypted with AES-256-GCM when saved via Web UI.
# DISCORD_TOKEN=your_discord_bot_token_here

# Application / Client ID from Discord Developer Portal General Information
# DISCORD_CLIENT_ID=your_discord_application_client_id

# Target Discord Server (Guild) ID for immediate guild slash command registration
# DISCORD_GUILD_ID=your_discord_guild_id_here

# Target Discord Text Channel ID where quota alerts and dispatch embeds are sent
# DISCORD_NOTIFICATION_CHANNEL_ID=your_discord_channel_id_here

# Strict Single-User Binding (Single-Tenant License Invariant)
# Restricts /quota and interactive dispatches strictly to this Discord User ID.
# If unset, Agylity automatically pins the first interacting Discord user ID for the session (TOFU).
# DISCORD_OWNER_USER_ID=your_discord_user_id_here

# Whether to ping/mention the owner (<@DISCORD_OWNER_USER_ID>) in quota milestone embeds (default: true)
DISCORD_PING_OWNER=true

# Generic Webhook Configuration (Used if webhook is in NOTIFICATION_CHANNELS)
# Receives JSON HTTP POST payloads on quota alerts and task lifecycle transitions
# NOTIFICATION_WEBHOOK_URL=https://webhook.example.com/alerts

# Optional HMAC-SHA256 signature secret for webhook payloads (sent in x-agylity-signature)
# Encrypted with AES-256-GCM when persisted in SQLite via Web UI.
# WEBHOOK_SECRET=your_webhook_hmac_secret_here

# Optional custom HTTP headers sent with webhook requests (JSON object string format)
# WEBHOOK_CUSTOM_HEADERS={"Authorization":"Bearer my-token"}

# ------------------------------------------------------------------------------
# 2. Antigravity Language Server & Connect-RPC Quota Engine
# ------------------------------------------------------------------------------
# Custom HTTP/HTTPS endpoint URL for the Antigravity Language Server.
# Leave blank (undefined) for automatic local process and port discovery.
ANTIGRAVITY_ENDPOINT_URL=
# Explicit CSRF token for Language Server Connect-RPC requests (auto-discovered if unset)
# ANTIGRAVITY_CSRF_TOKEN=

# ------------------------------------------------------------------------------
# 3. Quota Sentry & Milestone Evaluator
# ------------------------------------------------------------------------------
# Sentry polling interval in seconds.
# Default: 60 (1 minute). Minimum: 30 seconds.
QUOTA_CHECK_INTERVAL_SECONDS=60

# Quota alert headroom threshold percentage (0 - 100).
# Alerts trigger if remaining model quota percentage is >= this threshold.
# Default: 25 (alerts if >= 25% quota headroom remains unused at a milestone).
QUOTA_ALERT_THRESHOLD_PERCENT=25

# Milestone evaluation windows in hours remaining until quota reset deadline.
# Comma-separated descending integers.
# Default: 48,24,12 (alerts evaluated at 48h, 24h, and 12h before reset).
QUOTA_MILESTONE_HOURS=48,24,12

# Minimum dispatch quota headroom percentage floor (0 - 100).
# Prevents automated or manual task dispatches from burning billable AI credits or incurring
# pay-as-you-go overages when rolling quota is nearly exhausted.
# Default: 10 (dispatches require at least 10% remaining quota unless overridden).
MIN_DISPATCH_HEADROOM_PERCENT=10

# Whether usage past 0% quota draws purchased (billable) credits.
# The language server does NOT report this, so set it to match your account. With the safety
# floor above at 0 nothing else stands between a dispatch and a billable overage.
# Default: false
ALLOW_OVERAGE=false

# ------------------------------------------------------------------------------
# 4. Optional Task Coordinator & Swarm Runners
# ------------------------------------------------------------------------------
# Controls whether task continuation and runner execution capabilities are enabled.
# When false (default), Agylity operates purely as a 24/7 quota sentry with zero execution sockets.
# Default: false
COORDINATOR_ENABLED=false

# Default model used for task dispatches when not explicitly selected.
# Default: gemini-3.8-flash
# DEFAULT_DISPATCH_MODEL=gemini-3.8-flash

# Default reasoning effort for official agy CLI execution (low, medium, high, xhigh, max).
# Default: medium
# DEFAULT_DISPATCH_EFFORT=medium

# Optional shared fallback secret token for swarm runners.
# RUNNER_SHARED_SECRET=

# Maximum hours remaining before reset to release pre-reset opportunistic tasks and routines.
# Default: 4
# QUOTA_BURN_MAX_HOURS=4

# Minimum remaining pool headroom percentage required to release P2 opportunistic tasks.
# Default: 30
# QUOTA_BURN_MIN_HEADROOM_PERCENT=30

# Pre-configured target repositories JSON string (alternative to managing via Web UI).
# REPOSITORIES_JSON=[{"id":"repo-1","name":"Repo 1","path":"/repos/repo-1","cloneUrl":"https://github.com/org/repo-1.git","defaultBranch":"main"}]

# ------------------------------------------------------------------------------
# 5. Cryptographic Security & Secrets Encryption
# ------------------------------------------------------------------------------
# Master 256-bit encryption key for AES-256-GCM encryption of sensitive tokens in SQLite.
# Accepts a 64-character hex string or arbitrary passphrase (derived via SHA-256).
# If left blank, Agylity automatically generates and persists a protected key at data/.agylity.key.
AGYLITY_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. Optional Decoupled Web Dashboard (Zero-Overhead by Default)
# ------------------------------------------------------------------------------
# Controls whether the native node:http dashboard server is started.
# When false, zero HTTP listeners or sockets are bound, and zero web modules are loaded.
# Default: false
WEB_UI_ENABLED=false

# Port for the Web UI dashboard HTTP server.
# Default: 8484
WEB_UI_PORT=8484

# Host address to bind the Web UI dashboard HTTP server.
# Default: 0.0.0.0 (listen on all interfaces)
WEB_UI_HOST=0.0.0.0

# Bearer token authenticating Web UI control-plane operations (POST/PATCH/DELETE config, dispatch, logs).
# Required whenever WEB_UI_HOST is not a loopback address (e.g. 0.0.0.0): the server refuses to start without it.
# When set, every /api/* route except /api/health and the runner-token endpoints
# (/api/tasks/poll, /api/tasks/:id/status, /api/runners/register) requires Authorization: Bearer <token>.
# Unauthenticated web clients are locked behind a full-screen, zero-leak Control Plane Gate.
# WEB_UI_AUTH_TOKEN=

# Public origin of the dashboard (e.g. https://agylity.example.com).
# When set, Discord and webhook embed titles link to the task inspector or quota overview.
# Leave empty for plain, unlinked embeds.
# BASE_URL=

# Comma-separated list of allowed client IPv4/IPv6 addresses or CIDR blocks for Web UI access.
# When set, requests from any unlisted client IP are blocked with HTTP 403 Forbidden.
# ALLOWED_IP_RANGES=127.0.0.1,192.168.1.0/24

# Boolean: trust the client IP from proxy headers only when the direct TCP peer socket is a loopback or RFC1918 hop.
# TRUSTED_PROXIES=false

# ------------------------------------------------------------------------------
# 7. Logging & Sinks
# ------------------------------------------------------------------------------
# Minimum logging level for stdout, stderr, and internal log ring buffer.
# Options: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 8. Optional Swarm Runner Container (Runner Nodes Only)
# ------------------------------------------------------------------------------
# Outbound URL to the Agylity Coordinator HTTP server.
# COORDINATOR_URL=http://agylity:8484
#
# Persistent runner token obtained via registration (agyr_run_...)
# RUNNER_TOKEN=
#
# Optional GitHub token for authenticated git clone & branch push on remote runners
# GITHUB_TOKEN=
# Runners refuse to start without GITHUB_TOKEN: an unauthenticated runner clones anonymously,
# runs the entire task, then fails the push -- burning a full agent run for nothing.
# Only set this to run tokenless against a NON-GitHub remote.
# ALLOW_TOKENLESS_RUNNER=false

# Stable runner identity. The coordinator keys its runner list on this, so leaving it unset makes
# the id fall back to the container hostname and every recreation leaves a dead row behind.
# RUNNER_ID=agylity-runner-1
# RUNNER_NAME=agylity-runner-1
#
# Git commit author identity for automated task continuation commits
# GIT_AUTHOR_NAME=agylity[bot]
# GIT_AUTHOR_EMAIL=agylity@users.noreply.github.com
