# ==============================================================================
# agylity - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your deployment.
# Values defined here serve as Level 2 fallback precedence:
# Resolved Config = SQLite UI Overrides ?? Environment Variables (.env) ?? Built-in Defaults
#
# Generated from CONFIG_REGISTRY in src/config/schema.ts by `npm run docs:config`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Channel Notifications
# ------------------------------------------------------------------------------
# These settings pick the remote destinations only; every event reaches stdout and the Logs
# buffer regardless.

# Active remote channels (`discord`, `webhook`, `none`). Multiple channels can run concurrently
# (e.g. `discord,webhook`). Every event is written to stdout and the Logs buffer by the logger
# regardless of this setting; a stored `console` value is dropped with a warning.
# Default: none
NOTIFICATION_CHANNELS=none

# Discord Bot application secret token (encrypted at rest).
# DISCORD_TOKEN=

# Discord Application ID. Required for slash-command registration: without it `/quota` and
# `/dispatch` are never registered.
# DISCORD_CLIENT_ID=

# Target Discord Guild (Server) ID. Omitted, commands register globally instead of per-guild.
# DISCORD_GUILD_ID=

# Target Discord text channel ID for embeds.
# DISCORD_NOTIFICATION_CHANNEL_ID=

# Authorized Discord User ID for strict single-user binding (pins first interacting user via
# TOFU if unset).
# DISCORD_OWNER_USER_ID=

# Whether to mention/ping the owner (`<@ID>`) on the Discord Bot destination. Applies to the bot
# only; the webhook destination has its own `webhookPingOwner`.
# Default: true
DISCORD_PING_OWNER=true

# Webhook target URL for HTTP POST JSON notifications (encrypted at rest).
# NOTIFICATION_WEBHOOK_URL=

# Optional HMAC-SHA256 signature secret for `x-agylity-signature` (encrypted at rest).
# WEBHOOK_SECRET=

# Optional JSON object string containing custom HTTP headers sent with webhook requests (e.g.
# `{"Authorization":"Bearer ..."}`).
# WEBHOOK_CUSTOM_HEADERS=

# ------------------------------------------------------------------------------
# 2. Quota Sentry
# ------------------------------------------------------------------------------
# The sentry polls the Antigravity language server and alerts on quota milestones. The language
# server is discovered from a local process unless an endpoint is given here.

# Custom Language Server Connect-RPC URL (port and CSRF credentials are auto-discovered from
# local process by default).
ANTIGRAVITY_ENDPOINT_URL=

# Explicit CSRF token for Language Server Connect-RPC requests (auto-discovered if unset).
# ANTIGRAVITY_CSRF_TOKEN=

# TCP port of the local Antigravity Language Server, used when the port cannot be discovered
# from a running process.
# Default: 60643
# ANTIGRAVITY_LS_PORT=60643

# Sentry polling interval (60s = 1m). Min: 15.
# Default: 60
QUOTA_CHECK_INTERVAL_SECONDS=60

# Interval, in hours, for a periodic background `agy update` run by the coordinator daemon and
# by swarm runners between poll cycles (never while a task is executing). `0` disables it; a
# refresh is skipped while a quota probe or another update is in flight, and quota probes are
# skipped while an update runs. Failures are logged as warnings without stopping the process;
# the version transition is logged at info. Independent of the one-shot container start refresh
# (`AGY_UPDATE_ON_BOOT`, see [deployment](./deployment.md)).
# Default: 24
AGY_UPDATE_INTERVAL_HOURS=24

# Minimum quota headroom percentage triggering alert.
# Default: 25
QUOTA_ALERT_THRESHOLD_PERCENT=25

# Comma-separated deadline milestone evaluation windows.
# Default: 48,24,12
QUOTA_MILESTONE_HOURS=48,24,12

# Safety floor headroom % preventing paid overages. Setting it to `0` disables the floor
# entirely, so pair that with `ALLOW_OVERAGE` below.
# Default: 10
MIN_DISPATCH_HEADROOM_PERCENT=10

# Whether usage past 0% quota may draw purchased credits. The language server does not report
# this, so set it to match your account; it is the honest record of your overage posture.
# Default: false
ALLOW_OVERAGE=false

# ------------------------------------------------------------------------------
# 3. Optional Task Coordinator
# ------------------------------------------------------------------------------
# Task continuation and runner execution. With the coordinator disabled Agylity runs purely as a
# quota sentry and binds no execution sockets.

# Enable/disable optional task continuation & runner coordinator. Sentry alerts operate when
# false.
# Default: false
COORDINATOR_ENABLED=false

# Master switch for Tier 3 routine tasks. When `false`, no routine is auto-triggered regardless
# of its own `enabled` flag; the dashboard toggle writes this key.
# Default: true
ROUTINES_ENABLED=true

# Issue label that `POST /api/backlog/sync-github` imports as Tier 2 backlog items. Issues
# carrying it become pending work, and an active item is canceled when its issue closes
# upstream; a finished item keeps its status.
# Default: backlog
GITHUB_BACKLOG_LABEL=backlog

# GitHub PAT, a coordinator secret: encrypted at rest (`enc:v1`), masked in `GET /api/config`,
# and settable or clearable from **Settings** without a restart. Resolved from the SQLite
# override, then the coordinator's own `GITHUB_TOKEN` environment variable. Authenticates clone
# and push, pull requests, issue filing and `POST /api/backlog/sync-github` (without it that
# route falls back to the `gh` CLI and never calls REST unauthenticated). Each `POST
# /api/tasks/poll` attaches it to the lease in memory only, so a runner needs no token of its
# own and the value is never written to `swarm_tasks`, `runner.json` or a log.
# GITHUB_TOKEN=

# Coordinator guard and runner-side override. On the coordinator, a runner whose poll reports
# `credentialsAvailable: false` is not leased a GitHub-remote task unless this is `true`;
# leaving it off is the correct setting for a GitHub remote, where a tokenless run would clone
# anonymously, spend the run's quota and fail the push. A runner also reads the variable from
# its own environment, for a non-GitHub remote where anonymous clone and push are expected.
# Default: false
# ALLOW_TOKENLESS_RUNNER=false

# Stable runner identity. Falls back to `RUNNER_NAME`, which itself falls back to the bare host
# name — a container identity that changes on every recreation and leaves a dead runner in the
# list.
# Default: <hostname>
# RUNNER_ID=

# Stable runner identity used when `RUNNER_ID` is unset. Offline runners past a 10-minute grace
# are pruned automatically.
# Default: <hostname>
# RUNNER_NAME=

# Default model used for task dispatches when not explicitly selected. A model the active
# account tier withholds is resolved to the newest model the same pool group still serves (an AI
# Plus account holding only `gemini-3.8-flash` dispatches on it rather than on
# `gemini-4-hydrogen`); a group with no pool at all stays refused.
# Default: gemini-4-hydrogen
# DEFAULT_DISPATCH_MODEL=gemini-4-hydrogen

# Default reasoning effort passed to `agy --effort`. One of `low`, `medium`, `high`, `xhigh` —
# an unknown value is rejected.
# Default: medium
# DEFAULT_DISPATCH_EFFORT=medium

# Governance policy for every tier (`immediate`, `backlog`, `routine`), emitted as a `[Policy:
# ...]` directive. `all` lets every change through. `docs_only` suppresses the push and PR when
# any changed file is not documentation (doc extensions `.md` `.markdown` `.mdown` `.mkdn`
# `.txt` `.rst` `.adoc`; `README*`; `license`, `licence`, `notice`, `copying`, `authors`,
# `contributors`, `changelog`, `changes`, `code_of_conduct`, `contributing`, `security`; and
# `.svg`/`.png`/`.jpg`/`.jpeg`/`.gif`/`.webp` under `docs/` or `doc/`). `issues_only` and `none`
# suppress both the push and the PR regardless of content. The branch is discarded and the run
# reports a success with `no_changes`, unless it filed GitHub issues, which then settle it
# `completed` with `issueUrls`. Overridable per task via the `pr_policy` column (default
# `inherit`, meaning fall back to this value).
# Default: all
# PR_POLICY=all

# Optional shared fallback secret token for swarm runners.
# RUNNER_SHARED_SECRET=

# Routine fallback window: hours remaining before reset that release a Tier 3 routine which sets
# no `trigger_before_reset_hours` of its own. A manual `pre_reset` dispatch also waits for the
# reset to be this close before it leaves `QUOTA_BURN_QUEUED`.
# Default: 4
# QUOTA_BURN_MAX_HOURS=4

# Pre-reset burn floor: minimum remaining pool headroom percentage for a manual `pre_reset`
# dispatch to be released once its window opens. Falls back to `MIN_DISPATCH_HEADROOM_PERCENT`
# when unset or `0`; routines gate on their own `min_headroom_percent` instead.
# Default: 30
# QUOTA_BURN_MIN_HEADROOM_PERCENT=30

# Minimum effective headroom percentage a Tier 2 backlog spawn requires, range 0–100. It is a
# floor rather than an override: the spawn also has to clear `MIN_DISPATCH_HEADROOM_PERCENT`,
# and the higher of the two wins. Editable as **Backlog minimum headroom (%)** in **Settings →
# Coordinator**.
# Default: 40
# BACKLOG_MIN_HEADROOM_PERCENT=40

# How many Tier 2 backlog tasks the autonomous scheduler may keep active at once: `single` (1
# globally), `per_repo` (1 per repository, capped by online runners), or `per_runner` (1 per
# online runner, even on the same repository). Editable as **Backlog concurrency** in **Settings
# → Coordinator**.
# Default: per_repo
# BACKLOG_CONCURRENCY=per_repo

# Optional pre-configured repositories JSON array string (alternative to Web UI configuration).
# Default: []
# REPOSITORIES_JSON=[{"id":"repo-1","name":"Repo 1","path":"/repos/repo-1","cloneUrl":"https://github.com/org/repo-1.git","defaultBranch":"main"}]

# ------------------------------------------------------------------------------
# 4. Security & Encryption
# ------------------------------------------------------------------------------
# Secrets encryption and control-plane access. A non-loopback WEB_UI_HOST without
# WEB_UI_AUTH_TOKEN refuses to start rather than expose an unauthenticated control plane.

# Master 256-bit key for AES-256-GCM. Accepts 64-char hex or passphrase. If unset,
# auto-generates key at `data/.agylity.key`.
AGYLITY_SECRET_KEY=

# Bearer token locking down the control plane. Required when `WEB_UI_HOST` is not a loopback
# address (the server refuses to start without it); enforces constant-time verification,
# brute-force rate limits, and full lock screen.
# WEB_UI_AUTH_TOKEN=

# When true, a request bypasses Bearer token authentication only when **both** the resolved
# client IP and the direct peer socket are loopback (`127.0.0.0/8`, `::1`). A proxied or
# forwarded request whose socket is not loopback still requires the token.
# Default: true
WEB_UI_AUTH_EXEMPT_LOCALHOST=true

# Comma-separated list of allowed IPv4/IPv6 addresses and CIDR subnets. Blocks unauthorized
# clients with HTTP 403 when set.
# ALLOWED_IP_RANGES=

# When true, extracts client IP from proxy headers only when the direct peer socket is
# **loopback** (`127.0.0.0/8`, `::1/128`). Private ranges are deliberately NOT trusted —
# otherwise any host on the LAN or a Docker bridge could forge the client IP.
# Default: false
# TRUSTED_PROXIES=false

# ------------------------------------------------------------------------------
# 5. Decoupled Web Dashboard
# ------------------------------------------------------------------------------
# The native node:http dashboard. Disabled by default: zero listeners, zero web modules loaded.

# Enable/disable decoupled native HTTP web dashboard.
# Default: false
WEB_UI_ENABLED=false

# Web dashboard listening port.
# Default: 8484
WEB_UI_PORT=8484

# Web dashboard interface bind address.
# Default: 0.0.0.0
WEB_UI_HOST=0.0.0.0

# Public origin of the dashboard, e.g. `https://agylity.example.com`. When set, Discord and
# webhook embed titles link to the task inspector (dispatch status) or the quota overview
# (alerts). Unset keeps embeds unlinked; currently optional (may become required for future
# features such as OAuth/WebAuthn callbacks or inbound webhooks).
# BASE_URL=

# ------------------------------------------------------------------------------
# 6. Logging & Sinks
# ------------------------------------------------------------------------------
# Terminal output and the in-memory log ring buffer that streams to the dashboard.

# Minimum log level (`debug`, `info`, `warn`, `error`) for terminal stdout/stderr and web UI log
# buffer.
# Default: info
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 7. Storage & Runtime Paths
# ------------------------------------------------------------------------------
# Process paths read directly from the environment, never from a SQLite override.

# SQLite database holding config overrides, task history and runner records. Parent directories
# are created on boot.
# Default: data/agylity.db
# DATABASE_PATH=data/agylity.db

# Legacy quota milestone state file. Imported once into SQLite when the sentry ledger is empty,
# then never written again, so an upgrade does not re-fire alerts already sent.
# Default: data/state.json
# QUOTA_STATE_FILE_PATH=data/state.json

# Path to the `agy` binary the daemon and runners invoke. Useful when the CLI is not on `PATH`.
# Default: agy
# AGY_BIN_PATH=agy

# Overrides `AGY_BIN_PATH` everywhere it is resolved: the daemon's quota CLI, the coordinator's
# model catalog, and remote/swarm execution.
# REMOTE_AGY_BIN_PATH=

# ------------------------------------------------------------------------------
# 8. Swarm Runner
# ------------------------------------------------------------------------------
# Runner nodes only. Everything here is read straight from the process environment by
# src/runner-cli.ts, src/runner/git.ts and src/runner/executor.ts rather than through
# src/config/schema.ts, so none of it can be set as a dashboard override. ALLOW_TOKENLESS_RUNNER
# is the exception: the coordinator reads it as a schema-driven key (see the coordinator
# section) and a runner reads its own environment.

# URL of the central Agylity Coordinator server. A value with no scheme is read as `http://`.
# Default: http://127.0.0.1:8484
# COORDINATOR_URL=http://127.0.0.1:8484

# One-time runner registration token (`agyr_reg_...`, default TTL 1 hour) minted by `POST
# /api/runners/registration-token` and exchanged at `POST /api/runners/register` for a
# persistent runner token. An `agyr_run_...` value is read as `RUNNER_TOKEN`.
# REGISTRATION_TOKEN=

# Persistent runner token (`agyr_run_...`) issued when a registration token is exchanged. An
# `agyr_run_...` value supplied through `REGISTRATION_TOKEN` is treated the same way.
# RUNNER_TOKEN=

# Comma-separated labels advertised at registration, lowercased. A task that requires labels is
# only offered to a runner carrying all of them.
# RUNNER_LABELS=

# Comma-separated repository IDs this runner is scoped to. Empty means unscoped: it may claim
# any repository the coordinator offers.
# RUNNER_REPOSITORIES=

# Where the runner persists its identity and token, so a restart resumes instead of
# re-registering. Must be on writable, persistent storage.
# Default: data/runner.json (/data/runner.json in the image)
# RUNNER_STATE_PATH=

# Long-poll timeout, in milliseconds, for the runner's task-queue request.
# Default: 25000
# RUNNER_POLL_TIMEOUT_MS=25000

# Delay between polls after an empty long-poll, in milliseconds. A blank or non-numeric value
# falls back to the default instead of collapsing to `0`.
# Default: 2000
# RUNNER_IDLE_INTERVAL_MS=2000

# Git commit author name for automated task completion commits. `GIT_COMMITTER_NAME` overrides
# the committer identity, which otherwise reuses this value.
# Default: task `requestedBy`, else `User`
# GIT_AUTHOR_NAME=

# Git commit author email. `GIT_COMMITTER_EMAIL` overrides the committer identity, which
# otherwise reuses this value.
# Default: user@users.noreply.github.com
# GIT_AUTHOR_EMAIL=user@users.noreply.github.com

